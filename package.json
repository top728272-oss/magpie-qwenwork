{
  "name": "magpie-qwenwork",
  "version": "0.3.1",
  "description": "magpie provider plugin: QwenWork subscription models (Qwen, GLM, GPT, DeepSeek, Kimi, MiniMax) through the desktop MaaS gateway",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "qwenwork"
  ],
  "license": "MIT",
  "author": "top728272-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/top728272-oss/magpie-qwenwork.git"
  },
  "bugs": {
    "url": "https://github.com/top728272-oss/magpie-qwenwork/issues"
  },
  "homepage": "https://github.com/top728272-oss/magpie-qwenwork#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "e2e": "node scripts/e2e.mjs",
    "probe": "node scripts/probe.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "magpie": {
    "name": "QwenWork",
    "summary": {
      "en": "Use QwenWork subscription models (Qwen, GLM, GPT, DeepSeek, Kimi, MiniMax) in every agent",
      "zh": "在每个 agent 里使用 QwenWork 订阅模型（Qwen/GLM/GPT/DeepSeek/Kimi/MiniMax）"
    },
    "options": {
      "lang": "auto",
      "allowModelKeys": [],
      "debug": false
    },
    "maxConcurrency": 4,
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
